@model KerashineERP.Models.ViewModels.StockLedgerReportVM
@{
    ViewData["Title"] = "Stock Ledger";
}
<style>
    .report-card{ background:#fff; border-radius:16px; border:1px solid #ede9fe; overflow:hidden; }
    .report-header{ padding:20px; background:#f8f7ff; border-bottom:1px solid #ede9fe; }
    .ledger-table th{ background:#1e293b; color:#fff; font-size:11px; text-transform:uppercase; letter-spacing:0.5px; border:0; padding:12px 14px; }
    .ledger-table td{ padding:12px 14px; font-size:13px; vertical-align:middle; border-bottom:1px solid #f1f5f9; }
</style>

<div class="report-card">
    <div class="report-header">
        <div class="d-flex justify-content-between align-items-center">
            <div><h4 style="margin:0;font-weight:800;color:#1e293b;"><i class="fa fa-book mr-2" style="color:#7c3aed;"></i> Stock Ledger Report</h4><small class="text-muted">Opening + IN - OUT = Closing (Company: @Context.Session.GetInt32("CompanyID"))</small></div>
            <form method="get" class="d-flex gap-2">
                <select name="type" class="form-control form-control-sm" style="border-radius:8px;"><option value="All" selected="@(Model.FilterType=="All")">All Types</option><option value="RM">RM Only</option><option value="FG">FG Only</option><option value="PM">PM Only</option></select>
                <button class="btn btn-sm" style="background:#7c3aed;color:#fff;border-radius:8px;"><i class="fa fa-filter"></i> Filter</button>
                <button type="button" onclick="window.print()" class="btn btn-sm btn-dark" style="border-radius:8px;"><i class="fa fa-print"></i></button>
            </form>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table ledger-table mb-0">
            <thead><tr><th>Item Code</th><th>Item Name</th><th>Type</th><th class="text-right">Opening</th><th class="text-right" style="color:#10b981;">IN Qty</th><th class="text-right" style="color:#ef4444;">OUT Qty</th><th class="text-right">Closing</th><th>UOM</th><th class="text-right">Value</th></tr></thead>
            <tbody>
                @foreach(var item in Model.Items){
                <tr>
                    <td style="font-weight:700;">@item.ItemCode</td>
                    <td>@item.ItemName</td>
                    <td><span class="badge" style="background:#f1f5f9;color:#475569;border-radius:20px;font-size:10px;">@item.ItemType</span></td>
                    <td class="text-right">@item.OpeningQty.ToString("N2")</td>
                    <td class="text-right" style="color:#059669;font-weight:600;">+@item.InQty.ToString("N2")</td>
                    <td class="text-right" style="color:#dc2626;font-weight:600;">-@item.OutQty.ToString("N2")</td>
                    <td class="text-right" style="font-weight:800;background:#f8f7ff;">@item.ClosingQty.ToString("N2")</td>
                    <td class="text-muted">@item.UOM</td>
                    <td class="text-right">Rs @item.Value.ToString("N0")</td>
                </tr>
                }
            </tbody>
            <tfoot style="background:#1e293b;color:#fff;font-weight:700;"><tr><td colspan="3" class="text-right">TOTAL</td><td class="text-right">@Model.Items.Sum(x=>x.OpeningQty).ToString("N2")</td><td class="text-right">@Model.Items.Sum(x=>x.InQty).ToString("N2")</td><td class="text-right">@Model.Items.Sum(x=>x.OutQty).ToString("N2")</td><td class="text-right">@Model.Items.Sum(x=>x.ClosingQty).ToString("N2")</td><td></td><td class="text-right">Rs @Model.Items.Sum(x=>x.Value).ToString("N0")</td></tr></tfoot>
        </table>
    </div>
</div>