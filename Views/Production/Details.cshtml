@model KerashineERP.Models.Production.PRO_ProductionHeader
@{
    ViewData["Title"] = "Production Details";
}

<div class="ks-card">
    <div class="ks-card-header d-flex justify-content-between">
        <h4>Production Batch: @Model.BatchNo</h4>
        <a asp-action="Index" class="ks-btn" style="background:#e2e8f0;"><i class="fa fa-arrow-left"></i> Back</a>
    </div>
    <div class="ks-card-body">
        <div class="row mb-3">
            <div class="col-md-3"><strong>Date:</strong> @Model.ProductionDate.ToString("dd-MM-yyyy")</div>
            <div class="col-md-3"><strong>Product:</strong> @Model.Product?.ItemName</div> <!-- ✅ Fix 7: Null check -->
            <div class="col-md-3"><strong>Qty Produced:</strong> @Model.QuantityProduced</div>
            <div class="col-md-3"><strong>Status:</strong> @(Model.StatusCode == 1? "In Process" : "Completed")</div>
        </div>
        <div class="row mb-3">
            <div class="col-md-3"><strong>Total Cost:</strong> @Model.TotalCost.ToString("N2")</div>
            <div class="col-md-3"><strong>Cost/Unit:</strong> @Model.CostPerUnit.ToString("N2")</div>
            <div class="col-md-6"><strong>Remarks:</strong> @Model.Remarks</div>
        </div>

        <h5>Materials Used</h5>
        <table class="table table-bordered table-sm">
            <thead class="table-light">
                <tr>
                    <th>Type</th>
                    <th>Material</th>
                    <th>Qty Used</th>
                    <th>Cost/Unit</th>
                    <th>Total Cost</th>
                    <th>Remarks</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ProductionDetails!= null) // ✅ Fix 8: Null check
                {
                    foreach (var d in Model.ProductionDetails)
                    {
                        <tr>
                            <td>@d.MaterialType</td>
                            <td>@d.Material?.ItemName</td> <!-- ✅ Fix 9: Null check -->
                            <td>@d.QuantityUsed</td>
                            <td>@d.CostPerUnit.ToString("N2")</td>
                            <td>@d.TotalCost.ToString("N2")</td>
                            <td>@d.Remarks</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>