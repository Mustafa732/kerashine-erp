@model KerashineERP.Models.Inventory.INV_SET_UOM
@{
    ViewData["Title"] = "Edit UOM";
}

<div class="ks-card">
    <div class="ks-card-header">
        <h4>Edit Unit of Measure</h4>
    </div>
    <div class="ks-card-body">
        <form asp-action="Edit">
            <input type="hidden" asp-for="UOMId" />
            <input type="hidden" asp-for="Status" />
            <input type="hidden" asp-for="CreateDate" />
            <input type="hidden" asp-for="CreatedBy" />
            <input type="hidden" asp-for="CreatedByValue" />
            
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="row">
                <div class="col-md-6 ks-form-group">
                    <label asp-for="UOMCode" class="ks-form-label"></label>
                    <input asp-for="UOMCode" class="ks-form-control" />
                    <span asp-validation-for="UOMCode" class="text-danger"></span>
                </div>
                <div class="col-md-6 ks-form-group">
                    <label asp-for="UOMName" class="ks-form-label"></label>
                    <input asp-for="UOMName" class="ks-form-control" />
                    <span asp-validation-for="UOMName" class="text-danger"></span>
                </div>
            </div>

            <div class="ks-form-group">
                <label asp-for="Description" class="ks-form-label"></label>
                <textarea asp-for="Description" class="ks-form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="ks-form-group">
                <div class="form-check">
                    <input class="form-check-input" asp-for="IsActive" />
                    <label class="form-check-label" asp-for="IsActive">Active</label>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="ks-btn ks-btn-primary">
                    <i class="fa-solid fa-save"></i> Update
                </button>
                <a asp-action="Index" class="ks-btn" style="background:#e2e8f0; color:var(--ks-dark);">
                    <i class="fa-solid fa-arrow-left"></i> Back to List
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}