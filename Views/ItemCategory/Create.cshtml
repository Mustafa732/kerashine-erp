@model KerashineERP.Models.Inventory.INV_SET_Category
@{
    ViewData["Title"] = "Create Category";
}

<div class="ks-card">
    <div class="ks-card-header">
        <h4>Create Item Category</h4>
    </div>
    <div class="ks-card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="row">
                <div class="col-md-6 ks-form-group">
                    <label asp-for="CategoryName" class="ks-form-label"></label>
                    <input asp-for="CategoryName" class="ks-form-control" placeholder="e.g. Shampoo, Raw Chemicals" />
                    <span asp-validation-for="CategoryName" class="text-danger"></span>
                </div>
                <div class="col-md-6 ks-form-group">
                    <label asp-for="CategoryCode" class="ks-form-label"></label>
                    <input asp-for="CategoryCode" class="ks-form-control" placeholder="e.g. CAT001, CAT008" />
                    <span asp-validation-for="CategoryCode" class="text-danger"></span>
                </div>
            </div>

            <div class="ks-form-group">
                <label asp-for="Description" class="ks-form-label"></label>
                <textarea asp-for="Description" class="ks-form-control" rows="3" placeholder="Category description"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="ks-form-group">
                <div class="form-check">
                    <input class="form-check-input" asp-for="IsActive" checked />
                    <label class="form-check-label" asp-for="IsActive">Active</label>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="ks-btn ks-btn-primary">
                    <i class="fa-solid fa-save"></i> Save
                </button>
                <a asp-action="Index" class="ks-btn" style="background:#e2e8f0; color:#1e293b;">
                    <i class="fa-solid fa-arrow-left"></i> Back
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}