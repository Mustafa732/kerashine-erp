@model IEnumerable<KerashineERP.Models.Inventory.INV_SET_Category>
@{
    ViewData["Title"] = "Item Categories";
}

<div class="ks-card">
    <div class="ks-card-header">
        <h4>Item Categories</h4>
        <a asp-action="Create" class="ks-btn ks-btn-primary">
            <i class="fa-solid fa-plus"></i> Add New
        </a>
    </div>
    <div class="ks-card-body">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <div class="table-responsive">
            <table class="ks-table ks-table-sm" id="categoryTable">
                <thead>
                    <tr>
                        <th style="width:200px">@Html.DisplayNameFor(model => model.CategoryName)</th>
                        <th style="width:120px">@Html.DisplayNameFor(model => model.CategoryCode)</th>
                        <th>Description</th>
                        <th style="width:100px">Status</th>
                        <th style="width:90px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.CategoryName</strong></td>
                            <td>@item.CategoryCode</td>
                            <td>@item.Description</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="ks-badge ks-badge-success">Active</span>
                                }
                                else
                                {
                                    <span class="ks-badge ks-badge-danger">Inactive</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.CategoryId" class="ks-action-btn edit" title="Edit">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.CategoryId" class="ks-action-btn delete" title="Delete">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#categoryTable').DataTable({
                "pageLength": 25,
                "order": [[0, "asc"]],
                "columnDefs": [
                    { "orderable": false, "targets": 4 }
                ]
            });
        });
    </script>
}