@model KerashineERP.Models.Purchase.AR_SET_BusinessPartnerType
@{
    ViewData["Title"] = "Delete Business Partner Type";
}
<div class="ks-card">
    <div class="ks-card-header" style="background:#ef4444; color:#fff;">
        <h4><i class="fa-solid fa-triangle-exclamation"></i> Delete Business Partner Type</h4>
    </div>
    <div class="ks-card-body">
        <div class="alert" style="background:#fef2f2; border:1px solid #fecaca; color:#991b1b; border-radius:6px; padding:1rem; margin-bottom:1.5rem;">
            <h5 style="margin:0 0 0.5rem 0; font-size:1rem; font-weight:600;">Are you sure you want to delete this?</h5>
        </div>
        <dl class="row">
            <dt class="col-sm-3 ks-form-label">ID</dt>
            <dd class="col-sm-9" style="margin-bottom:1rem;"><code>@Model.BusinessPartnerID</code></dd>
            <dt class="col-sm-3 ks-form-label">Name</dt>
            <dd class="col-sm-9" style="margin-bottom:1rem;"><strong>@Model.BusinessPartnerName</strong></dd>
            <dt class="col-sm-3 ks-form-label">Status</dt>
            <dd class="col-sm-9" style="margin-bottom:1rem;">
                @if (Model.IsActive) { <span class="ks-badge ks-badge-success">Active</span> }
                else { <span class="ks-badge ks-badge-danger">Inactive</span> }
            </dd>
        </dl>
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="BusinessPartnerID" />
            <div class="d-flex gap-2">
                <button type="submit" class="ks-btn" style="background:#ef4444; color:#fff;"><i class="fa-solid fa-trash"></i> Delete</button>
                <a asp-action="Index" class="ks-btn" style="background:#e2e8f0; color:#1e293b;"><i class="fa-solid fa-arrow-left"></i> Cancel</a>
            </div>
        </form>
    </div>
</div>