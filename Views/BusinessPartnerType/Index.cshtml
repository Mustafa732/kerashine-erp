@model IEnumerable<KerashineERP.Models.Purchase.AR_SET_BusinessPartnerType>
@{
    ViewData["Title"] = "Business Partner Types";
}
<div class="ks-card">
    <div class="ks-card-header">
        <h4>Business Partner Types</h4>
        <a asp-action="Create" class="ks-btn ks-btn-primary"><i class="fa-solid fa-plus"></i> Add New</a>
    </div>
    <div class="ks-card-body">
        @if (TempData["Success"]!= null)
        { <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
        <div class="table-responsive">
            <table class="ks-table ks-table-sm" id="bpTypeTable">
                <thead>
                    <tr>
                        <th style="width:80px">ID</th>
                        <th>Business Partner Name</th>
                        <th>ShipTo</th>
                        <th style="width:100px">Status</th>
                        <th style="width:90px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.BusinessPartnerID</strong></td>
                            <td><strong>@item.BusinessPartnerName</strong></td>
                            <td>@item.ShipTo</td>
                            <td>
                                @if (item.IsActive) { <span class="ks-badge ks-badge-success">Active</span> }
                                else { <span class="ks-badge ks-badge-danger">Inactive</span> }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.BusinessPartnerID" class="ks-action-btn edit"><i class="fa-solid fa-pen"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.BusinessPartnerID" class="ks-action-btn delete"><i class="fa-solid fa-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts {
<script>$(document).ready(function(){ $('#bpTypeTable').DataTable({ "pageLength": 25 }); });</script>
}