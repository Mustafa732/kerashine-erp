@model KerashineERP.Models.Inventory.INV_Item
@{
    ViewData["Title"] = "Edit Item";
}

<div class="ks-card">
    <div class="ks-card-header">
        <h4>Edit Item</h4>
    </div>
    <div class="ks-card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="ItemId" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="row">
                <div class="col-md-3 ks-form-group">
                    <label asp-for="ItemCode" class="ks-form-label"></label>
                    <input asp-for="ItemCode" class="ks-form-control" placeholder="RM001, PM001, P001" />
                    <span asp-validation-for="ItemCode" class="text-danger"></span>
                </div>
                <div class="col-md-3 ks-form-group">
                    <label asp-for="ItemType" class="ks-form-label"></label>
                    <select asp-for="ItemType" class="ks-form-control" asp-items="ViewBag.ItemTypes" id="ItemType">
                        <option value="">-- Select Type --</option>
                    </select>
                    <span asp-validation-for="ItemType" class="text-danger"></span>
                </div>
                <div class="col-md-3 ks-form-group">
                    <label asp-for="ItemName" class="ks-form-label"></label>
                    <input asp-for="ItemName" class="ks-form-control" placeholder="Shampoo, SLES, Bottle" />
                    <span asp-validation-for="ItemName" class="text-danger"></span>
                </div>
                <div class="col-md-3 ks-form-group">
                    <label asp-for="CategoryId" class="ks-form-label"></label>
                    <select asp-for="CategoryId" class="ks-form-control" asp-items="ViewBag.CategoryId">
                        <option value="">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>
            </div>

            <div class="row fg-fields" style="display:none;">
                <div class="col-md-2 ks-form-group">
                    <label asp-for="ItemSize" class="ks-form-label"></label>
                    <input asp-for="ItemSize" class="ks-form-control" placeholder="250" />
                    <span asp-validation-for="ItemSize" class="text-danger"></span>
                </div>
                <div class="col-md-2 ks-form-group">
                    <label asp-for="SizeUOM" class="ks-form-label"></label>
                    <input asp-for="SizeUOM" class="ks-form-control" placeholder="ml, g" />
                    <span asp-validation-for="SizeUOM" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-3 ks-form-group">
                    <label asp-for="UOMId" class="ks-form-label"></label>
                    <select asp-for="UOMId" class="ks-form-control" asp-items="ViewBag.UOMId">
                        <option value="">-- Select UOM --</option>
                    </select>
                    <span asp-validation-for="UOMId" class="text-danger"></span>
                </div>
                <div class="col-md-3 ks-form-group">
                    <label asp-for="ReorderLevel" class="ks-form-label"></label>
                    <input asp-for="ReorderLevel" class="ks-form-control" type="number" step="0.01" value="0" />
                </div>
                <div class="col-md-3 ks-form-group">
                    <label asp-for="MinStock" class="ks-form-label"></label>
                    <input asp-for="MinStock" class="ks-form-control" type="number" step="0.01" value="0" />
                </div>
                <div class="col-md-3 ks-form-group">
                    <label asp-for="MaxStock" class="ks-form-label"></label>
                    <input asp-for="MaxStock" class="ks-form-control" type="number" step="0.01" value="0" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-12 ks-form-group">
                    <label asp-for="Description" class="ks-form-label"></label>
                    <textarea asp-for="Description" class="ks-form-control" rows="2"></textarea>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12 ks-form-group">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" checked />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="ks-btn ks-btn-primary"><i class="fa-solid fa-save"></i> Update</button>
                <a asp-action="Index" class="ks-btn" style="background:#e2e8f0;"><i class="fa fa-arrow-left"></i> Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            function toggleFields() {
                var type = $('#ItemType').val();
                if (type === 'FG' || type === 'PM') {
                    $('.fg-fields').show();
                } else {
                    $('.fg-fields').hide();
                    $('#SubItemName, #ItemSize, #SizeUOM, #PackagingCost').val('');
                }
            }
            $('#ItemType').change(toggleFields);
            toggleFields();
        });
    </script>
}